# Copia este archivo como .env y rellena con los datos de tu proyecto de Supabase
# (Panel de Supabase > Project Settings > API)

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Solo para los scripts de datos demo (scripts/seed-demo.js y
# scripts/cleanup-demo.js), ejecutados por ti desde la terminal.
# NUNCA le pongas el prefijo VITE_ a esta clave: si lo hicieras, Vite la
# incluiría en el código que se envía al navegador. Esta clave tiene
# permisos totales sobre tu proyecto; no la compartas ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta

# Solo para scripts/seed-demo.js y scripts/cleanup-demo.js: UUID de tu
# cuenta de prueba real. seed-demo.js la usa para crear una red de amigos
# demo aceptados; cleanup-demo.js la excluye explícitamente de cualquier
# borrado, incluso como capa extra de seguridad. Lo encuentras en Supabase >
# Table Editor > profiles, o en Authentication > Users.
DEMO_OWNER_USER_ID=uuid-de-tu-cuenta-de-prueba

# Opcionales para seed-demo.js (si no se indican, se usan 170 y 15):
# DEMO_TOTAL=170
# DEMO_NUM_AMIGOS=15
